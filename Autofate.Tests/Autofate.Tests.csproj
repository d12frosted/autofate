<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the plugin's pure decision logic. The plugin itself needs Dalamud and the game
    to load, so instead of referencing it this project compiles Autofate/Logic directly: code in
    there must only depend on the BCL (System.*), never on Dalamud, ECommons or the game.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Autofate\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
